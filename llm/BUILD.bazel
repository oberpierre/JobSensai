load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

filegroup(
    name = "prompts",
    srcs = glob(["prompts/**"]),
    visibility = ["//visibility:public"],
)

# One library per module, each carrying only the deps it actually imports, so a
# consumer does not transitively pull in unnecessary deps.
py_library(
    name = "dom",
    srcs = ["dom.py"],
    imports = [".."],
    deps = ["@pip//beautifulsoup4"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "html_cleaner",
    srcs = ["html_cleaner.py"],
    imports = [".."],
    deps = ["@pip//beautifulsoup4"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "model",
    srcs = ["model.py"],
    imports = [".."],
    data = ["//llm:prompts"],
    deps = ["@pip//langchain_ollama"],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "main",
    srcs = ["main.py"],
    imports = [".."],
    data = ["//:env", "//llm:prompts"],
    deps = [
        ":model",
        "@pip//python_dotenv",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "adapter_files",
    srcs = ["adapter_files.py"],
    imports = [".."],
    deps = [
        ":model",
        "@pip//python_dotenv",
    ],
    visibility = ["//visibility:public"],
)

# A library rather than the binary's own srcs, so a test depends on worker.py without
# also inheriting //:env. A developer's .env reaching the test runfiles decides the
# defaults those tests assert, which passes in CI, where there is none, and fails on
# the machine of whoever set the knob.
py_library(
    name = "worker_lib",
    srcs = ["worker.py"],
    imports = [".."],
    data = ["//llm:prompts"],
    deps = [
        ":adapter_files",
        ":dom",
        ":html_cleaner",
        ":model",
        "//adapters:adapters",
        "//adapters:adapters_base",
        "//publisher:publisher",
        "@pip//python_dotenv",
        "@pip//redis",
    ],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "worker",
    srcs = ["worker_main.py"],
    main = "worker_main.py",
    imports = [".."],
    data = ["//:env"],
    deps = [":worker_lib"],
    visibility = ["//visibility:public"],
)

py_test(
    name = "worker_lease_test",
    srcs = ["worker_lease_test.py"],
    imports = [".."],
    deps = [
        ":worker_lib",
        "//adapters:adapters_base",
        "@pip//redis",
    ],
    visibility = ["//visibility:public"],
)

py_test(
    name = "worker_task_dispatch_test",
