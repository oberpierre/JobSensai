load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

py_binary(
    name = "main",
    srcs = glob(
        ["**/*.py"],
        exclude = [
            "worker.py",
            "**/*_test.py",
        ],
    ),
    data = [
        "//:env",
        "//llm:prompts",
    ],
    deps = [
        "@pip//beautifulsoup4",
        "@pip//langchain",
        "@pip//langchain_ollama",
        "@pip//python_dotenv",
        "@pip//redis",
    ],
    python_version = "PY3",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "prompts",
    srcs = glob(["prompts/**"]),
    visibility = ["//visibility:public"],
)

py_binary(
    name = "worker",
    srcs = ["worker.py"],
    imports = [".."],
    data = [
        "//:env",
        "//llm:prompts",
    ],
    deps = [
        ":main",
        "//adapters:adapters",
        "//adapters:adapters_base",
        "@pip//pytest",
    ],
    visibility = ["//visibility:public"],
)

py_test(
    name = "worker_test",
    srcs = ["worker_test.py"],
    imports = [".."],
    deps = [
        ":worker",
        "//adapters:adapters_base",
        "@pip//redis",
    ],
    visibility = ["//visibility:public"],
)

py_test(
    name = "model_test",
    srcs = ["model_test.py"],
    data = ["//llm:prompts"],
    deps = [
        ":main",
    ],
    visibility = ["//visibility:public"],
)

py_test(
    name = "html_cleaner_test",
    srcs = ["html_cleaner_test.py"],
    deps = [
        ":main",
    ],
    visibility = ["//visibility:public"],
)

py_test(
    name = "dom_test",
    srcs = ["dom_test.py"],
    deps = [
        ":main",
    ],
    visibility = ["//visibility:public"],
)


