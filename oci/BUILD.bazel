load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_pkg//:pkg.bzl", "pkg_tar")
load(":py_layer.bzl", "py_app_layer", "py_entrypoint")

package(default_visibility = ["//visibility:private"])

# The cluster node this ships to is amd64, so every py_binary packaged below
# is cross-compiled to this platform by py_app_layer, but only the interpreter
# follows that transition. pip.parse() in MODULE.bazel declares no platforms,
# so each wheel is resolved once against whatever machine invokes `bazel build`,
# independent of this package's transition. An image built on a non-linux/amd64
# host therefore bundles a linux x86_64 interpreter next to host-native compiled
# wheels: it builds and loads without complaint, then fails at the first
# compiled import. These images are authoritative only when built on
# linux/amd64, which in practice means CI. The base images are referenced
# through their platform-suffixed repo (e.g. @distroless_cc_linux_amd64) rather
# than the plain alias, since the plain alias is a select() keyed on the
# *current* configuration's cpu and would fail to resolve from an arm64 host.
platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

# --- Crawler: //scraper:main, Scrapy + Playwright spider runner ---

py_app_layer(
    name = "crawler_layer",
    binary = "//scraper:main",
    target_platform = ":linux_x86_64",
)

oci_image(
    name = "crawler_image",
    base = "@playwright_python_linux_amd64",
    tars = [":crawler_layer"],
    entrypoint = py_entrypoint("main"),
    user = "65532",
    workdir = "/app",
)

oci_load(
    name = "crawler_load",
    image = ":crawler_image",
    repo_tags = ["jobsensai-crawler:latest"],
)

oci_push(
    name = "crawler_push",
    image = ":crawler_image",
    repository = "ghcr.io/oberpierre/jobsensai-crawler",
    # This target is deliberately not the one py_app_layer transitions: it
    # inherits whatever platform `bazel run` is invoked under, which is the
    # host's by default. Restricting it to linux/x86_64 makes a push from any other
    # host refuse instead of publishing an image whose wheels are that host's.
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

# --- Bronze worker: //scraper:worker, Redis to Postgres Bronze ingest ---

py_app_layer(
