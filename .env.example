# ============================================================================
# JobSensai Environment Configuration
# ============================================================================

# ============================================================================
# Database
# ============================================================================
POSTGRES_USER=jobsensai
POSTGRES_DB=jobsensai
POSTGRES_PASSWORD=devpass
# SECURITY NOTE: Change this password in production environments!

# Devcontainer:
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Manual Setup (uncomment these and comment out the above):
# POSTGRES_HOST=localhost
# POSTGRES_PORT=20001

# ============================================================================
# Redis
# ============================================================================
# Devcontainer:
REDIS_HOST=redis
REDIS_PORT=6379

# Manual Setup (uncomment these and comment out the above):
# REDIS_HOST=localhost
# REDIS_PORT=20002

# Unset or empty means no password, matching the devcontainer's unauthenticated Redis.
REDIS_PASSWORD=

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO

# ============================================================================
# Scraper Settings
# ============================================================================
SCRAPY_DOWNLOAD_DELAY=2
SCRAPY_CONCURRENT_REQUESTS=16

# ============================================================================
# LLM Service
# ============================================================================
# Devcontainer
# host.docker.internal allows the container to reach services on the host machine
OLLAMA_HOST=host.docker.internal
OLLAMA_PORT=11434

# Manual Setup (uncomment this and comment out the above):
# OLLAMA_HOST=localhost
# OLLAMA_PORT=11434
