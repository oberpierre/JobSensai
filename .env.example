# ============================================================================
# JobSensai Environment Configuration
# ============================================================================

# ============================================================================
# Database
# ============================================================================
POSTGRES_USER=jobsensai
POSTGRES_DB=jobsensai
POSTGRES_PASSWORD=devpass
# SECURITY NOTE: Change this password in production environments!

# Devcontainer:
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Manual Setup (uncomment these and comment out the above):
# POSTGRES_HOST=localhost
# POSTGRES_PORT=20001

# ============================================================================
# Redis
# ============================================================================
# Devcontainer:
REDIS_HOST=redis
REDIS_PORT=6379

# Manual Setup (uncomment these and comment out the above):
# REDIS_HOST=localhost
# REDIS_PORT=20002

# Unset or empty means no username/password, matching the devcontainer's
# unauthenticated Redis. REDIS_PASSWORD without REDIS_USERNAME authenticates as
# `default`
REDIS_USERNAME=
REDIS_PASSWORD=

# ============================================================================
# API
# ============================================================================
# The port the API binds and the port the web dev server proxies /api to, so both read this
# one variable. Setting it for one of them alone leaves the proxy pointing at nothing.
# API_PORT=8000

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO

# ============================================================================
# Scraper Settings
# ============================================================================
SCRAPY_DOWNLOAD_DELAY=2
SCRAPY_CONCURRENT_REQUESTS=16

# Cache fetched pages on disk for a day, which is what makes re-running a crawl against
# the same board cheap while developing an adapter. Off by default, because a scheduled
# run is a fresh pod that would write the cache and never read it.
# SCRAPY_HTTPCACHE=1

# ============================================================================
# LLM Service
# ============================================================================
# Devcontainer
# host.docker.internal allows the container to reach services on the host machine
OLLAMA_HOST=host.docker.internal
OLLAMA_PORT=11434

# Manual Setup (uncomment this and comment out the above):
# OLLAMA_HOST=localhost
# OLLAMA_PORT=11434

# Unset uses the default in llm/model.py.
# OLLAMA_MODEL=qwen3-coder:30b

# The window for a caller that asks for no particular one, which today is the CV service in
# llm/main.py alone. The learning loop sets its own per adapter type below, so raising this
# widens neither of those.
# OLLAMA_NUM_CTX=32768

# The learning loop's two windows. Discovery reads a pruned link-only skeleton and stays
# small, whereas extraction reads a whole posting body. Ollama sizes its KV cache from these,
# so a change of model is weighed against them together.
# DISCOVERY_NUM_CTX=32768
# EXTRACTION_NUM_CTX=65536

# How much cleaned HTML goes into a prompt. It has to stay inside whichever window above
# applies, because Ollama truncates the tail silently rather than refusing the request.
# LLM_HTML_CHARS=120000

# How long a requeued task waits before the worker polls again, so a requeue with an
# otherwise empty queue does not spin on the same task.
# REQUEUE_BACKOFF_SECONDS=30

# How long a learning run may hold its per-domain lease. A dense model reasoning over a
# wide context can outlive this default, and the symptom is two learning runs on one domain.
# LEARNING_LEASE_TTL_SECONDS=1800
