# The JobSensai web frontend, built with rules_js and Vite.

load("@aspect_rules_js//js:defs.bzl", "js_run_binary")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//web:eslint/package_json.bzl", eslint_bin = "bin")
load("@npm//web:typescript/package_json.bzl", tsc_bin = "bin")
load("@npm//web:vite/package_json.bzl", vite_bin = "bin")
load("@npm//web:vitest/package_json.bzl", vitest_bin = "bin")

npm_link_all_packages(name = "node_modules")

# Globbed so adding a component never edits this file.
SRCS = glob(["src/**"]) + [
    "eslint.config.js",
    "index.html",
    "package.json",
    "pnpm-lock.yaml",
    "tsconfig.json",
    "vite.config.ts",
    ":node_modules",
]

vite_bin.vite_binary(
    name = "vite",
    chdir = package_name(),
)

# Vite's dev server binds 127.0.0.1 by default, unreachable from outside the
# devcontainer. --host exposes it on the forwarded port fixed by --port.
vite_bin.vite_binary(
    name = "dev",
    args = [
        "dev",
        "--host",
        "0.0.0.0",
        "--port",
        "5173",
    ],
    chdir = package_name(),
)

js_run_binary(
    name = "dist",
    srcs = SRCS,
    args = ["build"],
    out_dirs = ["dist"],
    tool = ":vite",
    visibility = ["//visibility:public"],
)

vitest_bin.vitest_test(
    name = "vitest_test",
    args = ["run"],
    chdir = package_name(),
    data = SRCS,
)

tsc_bin.tsc_test(
    name = "typecheck_test",
    args = ["--noEmit"],
    chdir = package_name(),
    data = SRCS,
)

eslint_bin.eslint_test(
    name = "eslint_test",
    args = ["."],
    chdir = package_name(),
    data = SRCS,
)
