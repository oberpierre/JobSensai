load("@aspect_rules_lint//format:defs.bzl", "format_multirun", "format_test")

package(default_visibility = ["//:__subpackages__"])

# Runs Ruff formatter on all files in the workspace
# Usage: bazel run //tools/format (or via alias defined in root BUILD.bazel: bazel run format)
format_multirun(
    name = "format",
    python = "@aspect_rules_lint//format:ruff",
)

# Format validation test for CI/CD pipelines
# Design decision: Uses no_sandbox=True to include all workspace files without explicit srcs
# Trade-off: Reduced hermeticity for simplicity, relying on fast formatting runs
# Alternative: Explicitly list srcs for hermetic testing (requires maintenance when adding files)
# See: https://github.com/aspect-build/rules_lint/blob/main/docs/formatting.md#2-test-target
format_test(
    name = "format_tests",
    size = "small",
    python = "@aspect_rules_lint//format:ruff",
    no_sandbox = True,
    workspace = "//:BUILD.bazel"
)