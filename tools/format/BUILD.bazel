load("@aspect_rules_lint//format:defs.bzl", "format_multirun", "format_test")

package(default_visibility = ["//:__subpackages__"])

format_multirun(
    name = "format",
    python = "@aspect_rules_lint//format:ruff",
)

# The test target should ideally specify a list of srcs for Bazel's hermeticity, however adding srcs is
# easily forgotten when new files are added. Therefore we use no_sandbox=True to disable hermeticity
# and point the workspace to the root of the repo so that all files are included.
# This will run formatting over all files in the workspace which is only appropriate if the formatting
# is sufficiently fast, see the hint in the documentation as well:
# See: https://github.com/aspect-build/rules_lint/blob/main/docs/formatting.md#2-test-target
format_test(
    name = "format_tests",
    size = "small",
    python = "@aspect_rules_lint//format:ruff",
    no_sandbox = True,
    workspace = "//:BUILD.bazel"
)