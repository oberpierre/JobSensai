#!/usr/bin/env bash
# commit-msg - checks the message git is about to record.
#
# Checks conformance with Arlo's commit notation, <risk> <intent> <Summary>
# (see: https://github.com/RefactoringCombos/ArlosCommitNotation), and blocks a
# commit that does not follow it. A clone's own further checks run from
# local/commit-msg.d/*.sh, each in its own shell, reading the body from MSG_BODY.
#
# Installed by pointing git at this directory, the pointer being per-clone and not
# something a commit can carry:  git config core.hooksPath .githooks
set -uo pipefail

MSG_FILE="${1:-}"
[[ -z "$MSG_FILE" || ! -f "$MSG_FILE" ]] && exit 0

# git's own boilerplate is comment lines and, under --verbose, a diff below a
# scissors line. Both carry paths and punctuation that are not the author's prose.
body="$(sed -e '/^# *-\{2,\} *>8 *-\{2,\}/,$d' -e '/^#/d' "$MSG_FILE")"
subject="$(printf '%s\n' "$body" | grep -vE '^[[:space:]]*$' | head -1)"

[[ -z "$subject" ]] && exit 0

# A merge, revert or autosquash subject is generated by git rather than written,
# so the notation does not apply to it.
case "$subject" in
Merge\ * | Revert\ * | fixup!\ * | squash!\ * | amend!\ *) exit 0 ;;
esac

status=0

# <risk> <intent> <Summary>: risk in . ^ ! @, intent in F B R D T, either case.
if ! printf '%s\n' "$subject" | grep -qE '^[.^!@] [FfBbRrDdTt] .+'; then
  cat >&2 <<EOF
commit-msg: the subject is not in <risk> <intent> <Summary> form.

  $subject

Risk is one of . proven-safe, ^ validated-by-passing-tests (the default),
! risky, @ broken. Intent is one of F/f feature, B/b bugfix, R/r refactor,
D/d documentation, T/t test, uppercase where the change is substantial.
All three fields, every commit: "^ F Add the thing".
EOF
  status=1
fi

# A clone may add further checks here. They stay out of the repository when they
# rest on conventions recorded outside it, because a warning whose rule nobody in
# that clone can read costs reading time and settles nothing.
for extra in "${0%/*}"/local/commit-msg.d/*.sh; do
  [[ -r "$extra" ]] || continue
  MSG_BODY="$body" bash "$extra" || status=1
done

exit $status
