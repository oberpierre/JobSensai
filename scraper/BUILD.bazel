load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

# Scraper library containing core logic
py_library(
    name = "scraper_lib",
    srcs = glob(
        ["**/*.py"],
        exclude = ["**/*_test.py", "main.py"],
    ),
    imports = ["."],
    deps = [
        "@pip//scrapy",
        "@pip//scrapy_playwright",
        "@pip//playwright",
        "@pip//sqlalchemy",
        "@pip//psycopg2_binary",
        "@pip//redis",
        "@pip//python_dotenv",
        "//adapters:adapters",
    ],
)

# Main scraper binary. No data edge on //:env: this binary is packaged into
# an image, and configuration there arrives as env vars from the deploy's
# Secrets, never from a bundled file.
py_binary(
    name = "main",
    srcs = ["main.py"],
    imports = ["."],
    deps = [
        ":scraper_lib",
        "@pip//python_dotenv",
    ],
    python_version = "PY3",
)

# Worker binary. Same reasoning as :main.
py_binary(
    name = "worker",
    srcs = ["worker.py"],
    imports = ["."],
    deps = [
        ":scraper_lib",
        "@pip//python_dotenv",
    ],
    python_version = "PY3",
)

# Silver Worker binary. Same reasoning as :main.
py_binary(
    name = "silver_worker",
    srcs = ["silver_worker.py"],
    imports = ["."],
    deps = [
        ":scraper_lib",
        "@pip//python_dotenv",
    ],
    python_version = "PY3",
)

# Operator-run backfill: re-queues Bronze rows missing a Silver row once their
# adapter exists. Not wired into the deploy workflow; see module docstring.
py_binary(
    name = "backfill_silver",
    srcs = ["backfill_silver.py"],
    imports = ["."],
    deps = [
        ":scraper_lib",
        "@pip//python_dotenv",
    ],
    python_version = "PY3",
)

py_test(
    name = "main_test",
    srcs = ["main_test.py"],
    imports = ["."],
    deps = [
        ":main",
        ":scraper_lib",
    ],
    python_version = "PY3",
)

