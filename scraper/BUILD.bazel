load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

# Scraper library containing core logic
py_library(
    name = "scraper_lib",
    srcs = glob(
        ["**/*.py"],
        exclude = ["**/*_test.py", "main.py"],
    ),
    imports = ["."],
    deps = [
        "@pip//scrapy",
        "@pip//scrapy_playwright",
        "@pip//playwright",
        "@pip//sqlalchemy",
        "@pip//psycopg2_binary",
        "@pip//redis",
        "@pip//python_dotenv",
        "//adapters:adapters",
    ],
)

# Main scraper binary
py_binary(
    name = "main",
    srcs = ["main.py"],
    imports = ["."],
    deps = [
        ":scraper_lib",
        "@pip//python_dotenv",
    ],
    data = [
        "//:env",
    ],
    python_version = "PY3",
)

# Worker binary
py_binary(
    name = "worker",
    srcs = ["worker.py"],
    imports = ["."],
    data = [
        "//:env",
    ],
    deps = [
        ":scraper_lib",
        "@pip//python_dotenv",
    ],
    python_version = "PY3",
)

# Silver Worker binary
py_binary(
    name = "silver_worker",
    srcs = ["silver_worker.py"],
    imports = ["."],
    data = [
        "//:env",
    ],
    deps = [
        ":scraper_lib",
        "@pip//python_dotenv",
    ],
    python_version = "PY3",
)

